<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity Name="LegacyMenuBridge"
            Publisher="CN=LegacyMenuBridge"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LegacyMenuBridge</DisplayName>
    <PublisherDisplayName>LegacyMenuBridge</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.22000.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="LegacyMenuBridge"
                 Executable="LegacyMenuBridge.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none"
                          DisplayName="LegacyMenuBridge"
                          Description="Bridges legacy context-menu entries into the Windows 11 menu"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>

        <!-- COM server that implements IExplorerCommand. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="LegacyMenuBridge context menu">
              <com:Class Id="B7F3A2C1-9D4E-4F6A-8B2C-5E1D3A7F9B04"
                         Path="LegacyMenuBridge.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <com:ProgId Id="LegacyMenuBridge.Command" Clsid="B7F3A2C1-9D4E-4F6A-8B2C-5E1D3A7F9B04" />
          </com:ComServer>
        </com:Extension>

        <!-- Show the command in the Windows 11 modern context menu. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ClassicMenuFile"
                             Clsid="B7F3A2C1-9D4E-4F6A-8B2C-5E1D3A7F9B04" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ClassicMenuFolder"
                             Clsid="B7F3A2C1-9D4E-4F6A-8B2C-5E1D3A7F9B04" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

      </Extensions>
    </Application>
  </Applications>
</Package>
